{
  "name": "webstudio-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787 --local",
    "build": "tsc -b && vite build",
    "build:ui": "tsc -b && vite build",
    "prepare:frontend": "npm run build:ui && node scripts/prepare-frontend.mjs",
    "package:worker": "node scripts/package-worker.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "preview": "vite preview",
    "check": "tsc -b --pretty false"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@tailwindcss/vite": "^4.1.16",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "wrangler": "^4.46.0"
  }
}
